# No dependency lifecycle script (preinstall, install, postinstall of any
# package in the tree) runs in this folder: an install is no place for
# arbitrary code execution, and nothing here needs one (E25 S8, F58). CI, the
# image and the documented install also pass --ignore-scripts explicitly.
# `npm run build`, `npm test` and `npm start` still run this package's own
# named scripts.
ignore-scripts=true
