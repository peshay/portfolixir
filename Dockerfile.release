# The production image (ADR-0045 §2, #760): a Mix release built in one stage
# and run in a slim stage as a non-root user. This is the operator's local
# build behind `docker compose up --build`; it is never published anywhere.
#
# The development image stays in `Dockerfile` (source mounted, Mix present,
# used by docker-compose.dev.yml).

# --- build stage -----------------------------------------------------------
# The Hex team's image for exactly the Elixir and OTP patch CI runs, pinned by
# tag and digest (ADR-0045 §2). `mix release` bundles this image's ERTS, so the
# OTP named here is the OTP every instance runs; the official `elixir` library
# tag this used to name was frozen and shipped an OTP with published TLS-client
# advisories (the 2026-09-24 runtime hotfix). ci_test pins the parity with CI.
FROM hexpm/elixir:1.18.5-erlang-27.3.4.18-debian-bookworm-20261005-slim@sha256:312c162a27baf0613e218f916e1025d46146f01321a320e45e167bb82ebf5b3a AS build

ENV MIX_ENV=prod \
    MIX_HOME=/opt/mix \
    HEX_HOME=/opt/hex \
    HEX_VERSION=2.4.2 \
    LANG=C.UTF-8

# Both stages install their Debian packages through docker/apt-install.sh
# (#1092), which the step mounts rather than copies. With the build secret
# `build_ca` (below), apt fetches deb.debian.org over HTTPS and verifies
# against that CA; on a host that cannot reach deb.debian.org, the build
# arguments DEBIAN_MIRROR and DEBIAN_SECURITY_MIRROR name mirrors
# (--build-arg DEBIAN_MIRROR=http://mirror.example/). With none, apt runs
# exactly as before. The script says why the secret is mounted readable by all.
ARG DEBIAN_MIRROR
ARG DEBIAN_SECURITY_MIRROR
RUN --mount=type=secret,id=build_ca,mode=0444 \
    --mount=type=bind,source=docker/apt-install.sh,target=/run/apt-install.sh \
    sh /run/apt-install.sh build-essential git ca-certificates

# A build behind a proxy that re-signs TLS (#1026): pass the proxy's CA as the
# build secret `build_ca`, and each step below that downloads trusts it first
# (docker/trust-build-ca.sh, which says why each step does it itself),
#   docker build --secret id=build_ca,src=proxy-ca.crt -f Dockerfile.release .
# Each step sources the script, so with the secret its Hex reads the system
# store the CA lands in, and the script takes the CA out again when the step
# ends (#1136): no later step trusts it, and no layer keeps it. Without the
# secret nothing is added and Hex keeps its own bundle. The runtime stage
# reads it for apt alone, where it is mounted.
COPY --chmod=0755 docker/trust-build-ca.sh /usr/local/bin/trust-build-ca

RUN --mount=type=secret,id=build_ca \
    . /usr/local/bin/trust-build-ca && mix local.hex ${HEX_VERSION} --force && mix local.rebar --force

WORKDIR /app

COPY mix.exs mix.lock ./
COPY config config
RUN --mount=type=secret,id=build_ca \
    . /usr/local/bin/trust-build-ca && mix deps.get --only prod && mix deps.compile

COPY lib lib
COPY priv priv
RUN mix compile && mix phx.digest && mix release

# --- runtime stage ---------------------------------------------------------
# The same Debian release the build stage was built on, because the bundled
# ERTS links against its libraries; pinned by tag and digest.
FROM debian:bookworm-20261005-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

# The build stage's apt route (docker/apt-install.sh, #1092). The script and
# the optional `build_ca` secret are mounted for this step only, so neither
# reaches the image, and the sources the image keeps are Debian's own.
ARG DEBIAN_MIRROR
ARG DEBIAN_SECURITY_MIRROR
RUN --mount=type=secret,id=build_ca,mode=0444 \
    --mount=type=bind,source=docker/apt-install.sh,target=/run/apt-install.sh \
    sh /run/apt-install.sh \
      libstdc++6 openssl libncurses6 locales ca-certificates curl && \
    sed -i '/C.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

# No Erlang distribution (E25 S2, F62): the release is one node and nothing
# attaches to it, so no distribution listener is opened towards the sibling
# containers. `bin/portfolixir eval` still works; `remote` and `rpc` do not.
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MIX_ENV=prod \
    PHX_SERVER=true \
    RELEASE_DISTRIBUTION=none

WORKDIR /opt/app

# The one directory the runtime user owns: the stored logos, a Compose volume
# (docker-compose.yml), so they survive a rebuild and are backed up.
RUN groupadd --system portfolixir && \
    useradd --system --gid portfolixir --home /opt/app --shell /usr/sbin/nologin portfolixir && \
    install -d -o portfolixir -g portfolixir -m 0750 /var/lib/portfolixir/logos

# The release stays root-owned (E25 S2, F59): the user it runs as can read and
# run it, not change it. What it writes goes elsewhere: the logos to their
# directory, and whatever the start script puts in RELEASE_TMP (a daemon's
# pipes, a rebooted config) to /tmp rather than into the release.
COPY --from=build /app/_build/prod/rel/portfolixir ./
COPY docker/release-entrypoint.sh /usr/local/bin/release-entrypoint.sh
RUN chmod 0755 /usr/local/bin/release-entrypoint.sh

ENV PORTFOLIXIR_LOGO_DIR=/var/lib/portfolixir/logos \
    RELEASE_TMP=/tmp/portfolixir

USER portfolixir

EXPOSE 4000

ENTRYPOINT ["/usr/local/bin/release-entrypoint.sh"]
CMD ["start"]
