# The build context leaves out everything .gitignore leaves out (E25 S2):
# personal agent state, local settings, secrets, stored logos and generated
# files never enter an image. Every .gitignore pattern is mirrored here; a
# pattern git matches at any depth takes its `**/` form, because Docker
# anchors every pattern at the context root. ci_test keeps the two aligned.

# Git metadata and history (build context only)
.git
.gitignore
.gitattributes
.github

# Elixir / Phoenix
/_build/
/cover/
/deps/
/doc/
/.fetch
**/erl_crash.dump
**/*.ez
**/*.beam

# Phoenix assets
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json
/priv/static/security_logos/

# MCP companion
/mcp-server/node_modules/
/mcp-server/dist/

# Environment / secrets
**/.env
**/.env.*
!**/.env.example

# Database / local files
**/*.sqlite
**/*.sqlite3
**/*.db

# Generated local/CI artifacts
/tmp/test-runs/
/sbom/*.cdx.json
/.playwright-mcp/
/report/

# Worktree-local docker overrides (not part of the project compose contract)
/docker-compose.local.yml

# Sensitive finance data
**/*.portfolio
**/*.ppxml
**/*.broker.pdf
**/*.statement.pdf
**/real-data/
**/private-data/

# Personal agent state (never commit — see "Privacy And Disclosure" in AGENTS.md)
/_bmad/config.user.toml
/_bmad/memory/

# OS
**/.DS_Store

# Python tooling
**/__pycache__/
**/*.py[cod]

# Editors
**/.idea/
**/.vscode/

# Claude Code local state
.claude/worktrees/
.claude/settings.local.json

# Dialyzer PLTs (machine/version-specific build artifacts; CI caches separately)
/priv/plts/

# Agent builder quality-analysis output (generated, regenerable artifacts)
/skills/reports/

# A tool that writes to an unset path variable creates this directory
/undefined/

# Build context only: logs and temp files
/log
/tmp
**/*.log
