# pre-commit for CI's `pre-commit` job and for a local install, pinned with
# every dependency by version and sha256 (E25 S8, F60). requirements.txt is
# generated from this file, from inside this directory, by pip-tools on the
# Python CI runs (3.12):
#
#   pip-compile --generate-hashes --output-file=requirements.txt requirements.in
#
# and installed with
#
#   python3 -m pip install --require-hashes --only-binary :all: -r requirements.txt
#
# in CI; a local install runs the same pip inside a virtual environment
# (CONTRIBUTING.md), because an externally managed system Python refuses it.
pre-commit==4.7.0
# The hygiene hooks (trailing whitespace, end of file, YAML syntax, line
# endings) run as `language: system` hooks on this package and its
# dependencies (H65): pre-commit builds no hook environment of its own, which
# would resolve them from the package index unpinned on every install. The
# version is the one the hook repository was frozen to before.
pre-commit-hooks==5.0.0
