# Copy to .env. Every value below with "replace" must be replaced; the
# production Compose file refuses to start without the secrets.
PHX_HOST=localhost
PORT=4000
# Production (docker-compose.yml): the app builds DATABASE_URL from these.
# URL-safe on purpose (hex): the Compose file splices it into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# Development from source (mix phx.server) reads DATABASE_URL directly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolixir_dev
SECRET_KEY_BASE=replace-with-openssl-rand-base64-48
MIX_ENV=dev
# Both tokens: at least 32 bytes, never a placeholder (the app refuses to boot).
PORTFOLIXIR_API_TOKEN=replace-with-openssl-rand-base64-48
PORTFOLIXIR_MCP_TOKEN=replace-with-openssl-rand-base64-48
# Optional: require a login on the web UI (ADR-0045). Unset keeps the UI open.
PORTFOLIXIR_UI_PASSWORD=
# Optional: how many days a UI login stays valid, renewed while the instance is
# used (default 30). 0 means the login ends when the browser closes.
PORTFOLIXIR_SESSION_DAYS=30
# Optional: further Host names the instance answers under (comma-separated).
PORTFOLIXIR_ALLOWED_HOSTS=
# Optional: redirect plain HTTP and set HSTS when TLS is terminated for this instance.
PHX_FORCE_SSL=false
# Optional: proxies whose X-Forwarded-For the login throttle believes
# (addresses or CIDR blocks, comma-separated). Empty: the throttle keys on the
# connecting address, which behind a reverse proxy is the proxy itself.
PORTFOLIXIR_TRUSTED_PROXIES=
# Optional: further Host names the MCP companion answers under (comma-separated).
PORTFOLIXIR_MCP_ALLOWED_HOSTS=
PORTFOLIXIR_API_BASE_URL=http://127.0.0.1:4000
PORTFOLIXIR_MCP_TRANSPORT=stdio
